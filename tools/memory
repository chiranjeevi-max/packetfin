    "plain64-jsonraw": 192_020_480,
    "plain64-pdml": 178_946_048,
    "plain64-ek": 179_355_648,
    "tls64-detail": 221_233_152,
    "tls64-hexdump": 221_134_848,
    "tls64-json": 221_331_456,
    "tls64-jsonraw": 221_380_608,
    "tls64-pdml": 222_855_168,
