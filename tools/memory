@dataclass(frozen=True)
class Case:
    name: str
    args: tuple[str, ...]
    ceiling: int
    baseline: int | None
    export_capture: str | None = None


def pcap_bytes(frames: list[bytes]) -> bytes:
    out = bytearray(struct.pack("<IHHiIII", 0xA1B2C3D4, 2, 4, 0, 0, 65535, 1))
    for index, frame in enumerate(frames):
        out += struct.pack("<IIII", 1000 + index, 0, len(frame), len(frame))
        out += frame
    return bytes(out)


def ethernet_ipv4_tcp(payload: bytes, sequence: int, sport: int, dport: int) -> bytes:
    tcp_len = 20 + len(payload)
    total = 20 + tcp_len
    ip = bytearray(20)
    ip[0] = 0x45
    ip[2:4] = total.to_bytes(2, "big")
    ip[4:6] = (1).to_bytes(2, "big")
    ip[6:8] = (0x4000).to_bytes(2, "big")
    ip[8] = 64
    ip[9] = 6
    ip[12:16] = bytes((10, 0, 0, 2))
    ip[16:20] = bytes((10, 0, 0, 1))
    tcp = bytearray(20)
    tcp[0:2] = sport.to_bytes(2, "big")
    tcp[2:4] = dport.to_bytes(2, "big")
    tcp[4:8] = sequence.to_bytes(4, "big")
    tcp[8:12] = (1).to_bytes(4, "big")
    tcp[12] = 0x50
    tcp[13] = 0x18
    tcp[14:16] = (65535).to_bytes(2, "big")
    eth = bytes((0x02, 0, 0, 0, 0, 2)) + bytes((0x02, 0, 0, 0, 0, 1))
    eth += (0x0800).to_bytes(2, "big")
    return eth + bytes(ip) + bytes(tcp) + payload


def flow_frame(index: int) -> bytes:
    frame = bytearray(42)
    frame[0:6] = bytes((0x00, 0x11, 0x22, 0x33, 0x44, 0x55))
    frame[6:12] = bytes((0x66, 0x77, 0x88, 0x99, 0xAA, 0xBB))
    frame[12:14] = (0x0800).to_bytes(2, "big")
    ip = 14
    frame[ip] = 0x45
    frame[ip + 2 : ip + 4] = (28).to_bytes(2, "big")
    frame[ip + 4 : ip + 6] = (index & 0xFFFF).to_bytes(2, "big")
    frame[ip + 6 : ip + 8] = (0x4000).to_bytes(2, "big")
    frame[ip + 8] = 64
    frame[ip + 9] = 17
    frame[ip + 12 : ip + 16] = bytes(
        (10, (index >> 16) & 0xFF, (index >> 8) & 0xFF, index & 0xFF)
    )
    frame[ip + 16 : ip + 20] = bytes((203, 0, 113, 1))
    udp = 34
    frame[udp : udp + 2] = (5000).to_bytes(2, "big")
    frame[udp + 2 : udp + 4] = (6000).to_bytes(2, "big")
    frame[udp + 4 : udp + 6] = (8).to_bytes(2, "big")
    return bytes(frame)


def fragment_frame(index: int) -> bytes:
    frame = bytearray(50)
    frame[0:6] = bytes((0x02, 0, 0, 0, 0, 2))
    frame[6:12] = bytes((0x02, 0, 0, 0, 0, 1))
    frame[12:14] = (0x0800).to_bytes(2, "big")
    ip = 14
    frame[ip] = 0x45
    frame[ip + 2 : ip + 4] = (36).to_bytes(2, "big")
    frame[ip + 4 : ip + 6] = (index & 0xFFFF).to_bytes(2, "big")
    frame[ip + 6 : ip + 8] = (0x2000).to_bytes(2, "big")  # MF, offset zero
    frame[ip + 8] = 64
    frame[ip + 9] = 17
    frame[ip + 12 : ip + 16] = bytes(
        (10, (index >> 16) & 0xFF, (index >> 8) & 0xFF, index & 0xFF)
    )
    frame[ip + 16 : ip + 20] = bytes((192, 0, 2, 1))
    udp = 34
    frame[udp : udp + 2] = (40000).to_bytes(2, "big")
    frame[udp + 2 : udp + 4] = (33434).to_bytes(2, "big")
    frame[udp + 4 : udp + 6] = (16).to_bytes(2, "big")
    for offset in range(8):
        frame[42 + offset] = (index * 31 + offset) & 0xFF
    return bytes(frame)


def write_capture(path: Path, frames: list[bytes]) -> None:
    path.write_bytes(pcap_bytes(frames))


def small_captures(captures: Path, regenerate: bool) -> None:
    empty = captures / "empty.pcap"
    if regenerate or not empty.is_file() or empty.stat().st_size != 24:
        empty.write_bytes(pcap_bytes([]))
    one = captures / "one.pcap"
    one_size = 24 + 16 + 42
    if regenerate or not one.is_file() or one.stat().st_size != one_size:
        one.write_bytes(pcap_bytes([flow_frame(0)]))
    flows = captures / "flows-1m.pcap"
    flows_size = 24 + 1_000_000 * (16 + 42)
    if regenerate or not flows.is_file() or flows.stat().st_size != flows_size:
        flows.write_bytes(pcap_bytes([flow_frame(index) for index in range(1_000_000)]))
    fragments = captures / "fragments-1m.pcap"
    fragments_size = 24 + 1_000_000 * (16 + 50)
    if (
        regenerate
        or not fragments.is_file()
        or fragments.stat().st_size != fragments_size
    ):
        fragments.write_bytes(
            pcap_bytes([fragment_frame(index) for index in range(1_000_000)])
        )


def large_captures(captures: Path, regenerate: bool) -> None:
    expected = {
        "plain64.pcap": 70_326_699,
        "chunked64.pcap": 70_663_861,
        "tls64.pcap": 70_669_350,
        "tls64-keys.log": 176,
    }
    missing = [
        name
        for name, size in expected.items()
        if regenerate
        or not (captures / name).is_file()
        or (captures / name).stat().st_size != size
    ]
    if not missing:
        return
    generator = REPO_ROOT / "target" / "release" / "gen-load"
    command = (
        [str(generator), str(captures)]
        if generator.is_file()
        else [
            "cargo",
            "run",
            "--quiet",
            "--release",
            "-p",
            "packetfin-testkit",
            "--bin",
            "gen-load",
            "--",
            str(captures),
        ]
    )
    print(f"memory: generating large captures in {captures}", file=sys.stderr)
    result = subprocess.run(command, cwd=REPO_ROOT)
    if result.returncode != 0:
        raise SystemExit("memory: gen-load failed")


def time_command(binary: Path, arguments: tuple[str, ...]) -> list[str]:
    time_binary = Path("/usr/bin/time")
    if not time_binary.is_file():
        raise SystemExit("memory: /usr/bin/time is required for peak-RSS measurement")
    flag = "-l" if sys.platform == "darwin" else "-v"
    return [str(time_binary), flag, str(binary), *arguments]


def parse_rss(stderr: str) -> int:
    match = re.search(r"(\d+)\s+maximum resident set size", stderr)
    if match:
        return int(match.group(1))
    match = re.search(r"Maximum resident set size \(kbytes\):\s*(\d+)", stderr)
    if match:
        return int(match.group(1)) * 1024
    raise SystemExit(f"memory: cannot parse peak RSS from:\\n{stderr[-2000:]}")


def measure(binary: Path, arguments: tuple[str, ...]) -> int:
    command = time_command(binary, arguments)
    result = subprocess.run(
        command,
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
        errors="replace",
    )
    if result.returncode not in (0,):
        raise SystemExit(
            f"memory: {' '.join(arguments)} exited {result.returncode}\\n"
            f"{result.stderr[-2000:]}"
        )
    return parse_rss(result.stderr)


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as source:
        for block in iter(lambda: source.read(1 << 20), b""):
            digest.update(block)
    return digest.hexdigest()


def verify_export(captures: Path, name: str, binary: Path, extra: tuple[str, ...]) -> None:
    export_dir = captures / f"out-{name}"
    shutil.rmtree(export_dir, ignore_errors=True)
    export_dir.mkdir(parents=True)
    arguments = (
        "-n",
        "-q",
        "-r",
        str(captures / f"{name}.pcap"),
        *extra,
        "--export-objects",
        f"http,{export_dir}",
    )
    result = subprocess.run(
        [str(binary), *arguments],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
        errors="replace",
    )
    if result.returncode != 0:
        raise SystemExit(f"memory: export {name} exited {result.returncode}")
    files = [path for path in export_dir.iterdir() if path.is_file()]
    if len(files) != 1:
        raise SystemExit(f"memory: export {name} wrote {len(files)} files")
    digest = sha256_file(files[0])
    if files[0].stat().st_size != OBJECT_BYTES or digest != EXPORT_HASHES[name]:
        raise SystemExit(
            f"memory: export {name} changed: {files[0].stat().st_size} bytes {digest}"
        )


def cases(captures: Path) -> list[Case]:
    default_ceiling = DEFAULT_CEILING + RECORDED_BASELINE
    two_ledger_ceiling = TWO_LEDGER_CEILING + RECORDED_BASELINE
    flows = captures / "flows-1m.pcap"
    fragments = captures / "fragments-1m.pcap"
    keylog = captures / "tls64-keys.log"
    cases = [
        Case("one-frame", ("-n", "-q", "-r", str(captures / "one.pcap")), default_ceiling, None),
        Case(
            "mixed-stats-attributable",
            (
                "-n",
                "-q",
                "-r",
                str(flows),
                "-z",
                "conv,udp",
                "-z",
                "endpoints,udp",
                "--pf-state-budget",
                "0",
                "--pf-stats-budget",
                str(64 * MIB),
            ),
            RECORDED_BASELINE + 64 * MIB,
            RECORDED_PEAKS["mixed-stats-attributable"],
        ),
        Case(
            "mixed-64-64",
            (
                "-n",
                "-q",
                "-r",
                str(flows),
                "-z",
                "conv,udp",
                "-z",
                "endpoints,udp",
                "--pf-state-budget",
                str(64 * MIB),
                "--pf-stats-budget",
                str(64 * MIB),
            ),
            two_ledger_ceiling,
            RECORDED_PEAKS["mixed-64-64"],
        ),
        Case(
            "flows-1m",
            ("-n", "-q", "-r", str(flows)),
            default_ceiling,
            RECORDED_PEAKS["flows-1m"],
        ),
        Case(
            "fragments-1m",
            ("-n", "-q", "-r", str(fragments)),
            default_ceiling,
            RECORDED_PEAKS["fragments-1m"],
        ),
        Case(
            "plain64-export",
            (
                "-n",
                "-q",
                "-r",
                str(captures / "plain64.pcap"),
                "--export-objects",
                f"http,{captures / 'out-plain64-peak'}",
            ),
            default_ceiling,
            RECORDED_PEAKS["plain64-export"],
            "plain64",
        ),
        Case(
            "tls64-export",
            (
                "-n",
                "-q",
                "-r",
                str(captures / "tls64.pcap"),
                "-o",
                f"tls.keylog_file:{keylog}",
                "--export-objects",
                f"http,{captures / 'out-tls64-peak'}",
            ),
            default_ceiling,
            RECORDED_PEAKS["tls64-export"],
            "tls64",
        ),
        Case(
            "chunked64-export",
            (
                "-n",
                "-q",
                "-r",
                str(captures / "chunked64.pcap"),
                "--export-objects",
                f"http,{captures / 'out-chunked64-peak'}",
            ),
            default_ceiling,
            RECORDED_PEAKS["chunked64-export"],
            "chunked64",
        ),
    ]
    keylog_arg = ("-o", f"tls.keylog_file:{keylog}")
    for name, path, extra in (
        ("plain64", captures / "plain64.pcap", ()),
        ("tls64", captures / "tls64.pcap", keylog_arg),
        ("chunked64", captures / "chunked64.pcap", ()),
    ):
        for mode, mode_args in OUTPUT_MODES:
            cases.append(
                Case(
                    f"{name}-{mode}",
                    ("-n", "-r", str(path), *extra, *mode_args),
                    default_ceiling,
                    RECORDED_PEAKS.get(f"{name}-{mode}"),
                )
            )
        for field in ("http.file_data", "tcp.reassembled.data"):
            cases.append(
                Case(
                    f"{name}-fields-{field}",
                    ("-n", "-r", str(path), *extra, "-T", "fields", "-e", field),
                    default_ceiling,
                    RECORDED_PEAKS.get(f"{name}-fields-{field}"),
                )
            )
    return cases


def clean_exports(captures: Path) -> None:
    for name in ("plain64", "tls64", "chunked64"):
        shutil.rmtree(captures / f"out-{name}", ignore_errors=True)
        shutil.rmtree(captures / f"out-{name}-peak", ignore_errors=True)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--binary", type=Path, default=DEFAULT_BINARY)
    parser.add_argument("--captures", type=Path, default=DEFAULT_CAPTURES)
    parser.add_argument("--repeats", type=int, default=DEFAULT_REPEATS)
    parser.add_argument("--regenerate", action="store_true")
    arguments = parser.parse_args(argv)
    if arguments.repeats < 1:
        parser.error("--repeats must be at least 1")
    binary = arguments.binary
    if not binary.is_absolute():
        binary = (REPO_ROOT / binary).resolve()
    if not binary.is_file() or not os.access(binary, os.X_OK):
        raise SystemExit(f"memory: release binary is missing: {binary} (run cargo build --release)")
    captures = arguments.captures
    captures.mkdir(parents=True, exist_ok=True)

    clean_exports(captures)
    small_captures(captures, arguments.regenerate)
    large_captures(captures, arguments.regenerate)

    for name in ("plain64", "tls64", "chunked64"):
        extra = (
            ("-o", f"tls.keylog_file:{captures / 'tls64-keys.log'}")
            if name == "tls64"
            else ()
        )
        verify_export(captures, name, binary, extra)
    clean_exports(captures)

    baseline = measure(binary, ("-n", "-q", "-r", str(captures / "one.pcap")))
    failures: list[str] = []
    print(f"memory: fixed baseline {baseline} B (recorded {RECORDED_BASELINE} B)")
    if baseline > RECORDED_BASELINE * 1.10:
        failures.append(
            f"one-frame baseline regressed: {baseline} > 110% of {RECORDED_BASELINE}"
        )

    print(
        f"{'case':<26}{'peak B':>14}{'ceiling B':>14}{'baseline B':>14}  result"
    )
    for case in cases(captures):
        peaks = []
        for _ in range(arguments.repeats):
            if case.export_capture is not None:
                shutil.rmtree(captures / f"out-{case.export_capture}-peak", ignore_errors=True)
            peaks.append(measure(binary, case.args))
        peak = max(peaks)
        reasons = []
        if peak > case.ceiling:
            reasons.append(f"above the memory ceiling by {peak - case.ceiling} B")
        if case.baseline is not None and peak > int(case.baseline * 1.10):
            reasons.append(f"regressed above 110% of {case.baseline} B")
        result = "ok" if not reasons else "FAIL: " + "; ".join(reasons)
        if reasons:
            failures.append(f"{case.name}: {result} (peak {peak} B)")
        baseline_text = "-" if case.baseline is None else str(case.baseline)
        print(f"{case.name:<26}{peak:>14}{case.ceiling:>14}{baseline_text:>14}  {result}")
        if case.export_capture is not None:
            extra = (
                ("-o", f"tls.keylog_file:{captures / 'tls64-keys.log'}")
                if case.export_capture == "tls64"
                else ()
            )
            verify_export(captures, case.export_capture, binary, extra)

    clean_exports(captures)
    if failures:
        print("memory: FAIL", file=sys.stderr)
        for failure in failures:
            print(f"  {failure}", file=sys.stderr)
        return 1
    print("memory: all cases within the memory ceiling and recorded baselines")
    return 0


if __name__ == "__main__":
    started = time.monotonic()
    status = main(sys.argv[1:])
    print(f"memory: {time.monotonic() - started:.1f} s", file=sys.stderr)
    raise SystemExit(status)
