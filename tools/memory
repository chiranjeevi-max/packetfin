#!/usr/bin/env python3
"""Memory-ceiling regression matrix.

Generates the large captures that are too big to commit, then measures peak
resident memory of the release binary for:

* the fixed one-frame baseline with the default ledgers;
* the mixed ``-z conv,udp -z endpoints,udp`` case at 64 MiB state and 64 MiB
  statistics (and its statistics-attributable part with no state);
* 1,000,000 one-packet flows and 1,000,000 IPv4 fragments;
* one 64 MiB HTTP object exported plain, over TLS 1.2 and chunked;
* every rendered output mode of those objects (`-V`, `-x`, JSON, JSON raw,
  EK and PDML).

Every case fails when peak RSS exceeds the documented memory ceiling
(``state + statistics + annotation + fixed baseline``) or when it regresses
more than 10% against the recorded baseline. The object cases also verify the
exported SHA-256 against the stored expected hashes.

Usage:
    cargo build --release
    tools/memory
    tools/memory --binary target/release/packetfin --repeats 3
    tools/memory --captures /tmp/pf-memory --regenerate

``tools/stress --memory`` runs this matrix with the stress campaign.
"""

from __future__ import annotations

import argparse
import hashlib
import os
import re
import shutil
import struct
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
DEFAULT_BINARY = REPO_ROOT / "target" / "release" / "packetfin"
DEFAULT_CAPTURES = Path("/tmp/packetfin-memory-captures")
DEFAULT_REPEATS = 3
MIB = 1024 * 1024
OBJECT_BYTES = 64 * MIB

# Default budgets: 256 MiB state, 64 MiB statistics, 64 MiB annotations.
DEFAULT_CEILING = (256 + 64 + 64) * MIB
TWO_LEDGER_CEILING = (64 + 64 + 64) * MIB

# Recorded 2026-11-05 on macOS 27.2 arm64 (Apple M5 Pro, 24 GB). The
# one-frame value is measured with all ledgers enabled at their defaults; it
# did not move when each ledger was disabled individually (the empty capture
# peaks at 8,552,448 B).
RECORDED_BASELINE = 9_224_192

# Peak RSS recorded for each case on the same host. A case fails when it
# exceeds its baseline by more than 10%, matching the performance guard.
RECORDED_PEAKS = {
    "mixed-64-64": 113_475_584,
    "mixed-stats-attributable": 57_737_216,
    "plain64-export": 178_225_152,
    "tls64-export": 220_905_472,
    "chunked64-export": 253_886_464,
    "flows-1m": 234_799_104,
